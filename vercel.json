{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/app.js": {
      "maxDuration": 180,
      "includeFiles": "{index.html,app.js,avatar.js,lipsync.js,style.css,assets/retrato-guatemala.png,assets/logo-constitucional.png,assets/nombre-constitucional.png,assets/favicon.ico,assets/icono-constitucional-32.png,assets/apple-touch-icon.png}"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/app?__route=/" },
    { "source": "/index.html", "destination": "/api/app?__route=/index.html" },
    { "source": "/app.js", "destination": "/api/app?__route=/app.js" },
    { "source": "/avatar.js", "destination": "/api/app?__route=/avatar.js" },
    { "source": "/lipsync.js", "destination": "/api/app?__route=/lipsync.js" },
    { "source": "/style.css", "destination": "/api/app?__route=/style.css" },
    { "source": "/retrato.png", "destination": "/api/app?__route=/retrato.png" },
    { "source": "/logo-constitucional.png", "destination": "/api/app?__route=/logo-constitucional.png" },
    { "source": "/nombre-constitucional.png", "destination": "/api/app?__route=/nombre-constitucional.png" },
    { "source": "/favicon.ico", "destination": "/api/app?__route=/favicon.ico" },
    { "source": "/icono-constitucional-32.png", "destination": "/api/app?__route=/icono-constitucional-32.png" },
    { "source": "/apple-touch-icon.png", "destination": "/api/app?__route=/apple-touch-icon.png" },
    { "source": "/api/:action(config|chat|documents|document-upload|document-index|document-validity|transcribe|speech|admin-login)", "destination": "/api/app?__route=/api/:action" }
  ]
}
